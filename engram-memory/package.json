{
  "name": "@app-apopov/dsh-engram-memory",
  "version": "0.3.0",
  "description": "Project-scoped memory for DSH backed by Engram: memory_save, memory_search and memory_context keep each project's memory inside its own folder, and the plugin page lets you browse, edit and delete it.",
  "license": "MIT",
  "author": "apopov-app",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "memory",
    "engram"
  ],
  "type": "module",
  "engines": {
    "dsh": ">=0.2.1-rc.5 <0.3.0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/apopov-app/dsh-plugins.git",
    "directory": "engram-memory"
  },
  "homepage": "https://github.com/apopov-app/dsh-plugins/tree/main/engram-memory#readme",
  "bugs": {
    "url": "https://github.com/apopov-app/dsh-plugins/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
