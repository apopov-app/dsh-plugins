{
  "name": "@apopov-app/dsh-stt-gigaam",
  "version": "1.0.0",
  "description": "Offline Russian speech recognition provider for DSH voice input: Sber GigaAM v3 (CTC, ONNX) running locally through sherpa-onnx.",
  "license": "MIT",
  "author": "apopov-app",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "speech-to-text",
    "asr",
    "russian",
    "gigaam",
    "offline"
  ],
  "type": "module",
  "engines": {
    "dsh": ">=0.2.1-rc.5 <0.3.0"
  },
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "worker.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "sherpa-onnx-node": "1.13.8"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
